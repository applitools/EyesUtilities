<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.applitools.eyesutilities</groupId>
  <artifactId>EyesUtilities</artifactId>
  <name>eyes-utilities</name>
  <version>1.7.0</version>
  <url>http://maven.apache.org</url>
  <build>
    <finalName>../jars/${project.artifactId}_${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>7.1.1</version>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.15.0</version>
        <executions>
          <execution>
            <id>install-node-and-npm</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
          </execution>
          <execution>
            <id>npm-ci</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>ci</arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm-run-build</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <workingDirectory>gui</workingDirectory>
          <installDirectory>${project.build.directory}</installDirectory>
          <nodeVersion>v20.12.2</nodeVersion>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-gui-bundle</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <overwrite>true</overwrite>
              <outputDirectory>${project.build.outputDirectory}/web</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/gui/dist</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <transformers>
            <transformer>
              <mainClass>com.applitools.eyesutilities.EyesUtilities</mainClass>
            </transformer>
          </transformers>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.2.2</version>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>gui-installers</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>stage-installer-input</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/installer-input</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.basedir}/jars</directory>
                      <includes>
                        <include>${installer.input.jar}</include>
                      </includes>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.1.1</version>
            <executions>
              <execution>
                <id>run-jpackage</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>jpackage</executable>
                  <arguments>
                    <argument>--input</argument>
                    <argument>${project.build.directory}/installer-input</argument>
                    <argument>--type</argument>
                    <argument>${installer.type}</argument>
                    <argument>--name</argument>
                    <argument>EyesUtilities</argument>
                    <argument>--main-jar</argument>
                    <argument>${installer.input.jar}</argument>
                    <argument>--main-class</argument>
                    <argument>com.applitools.eyesutilities.EyesUtilities</argument>
                    <argument>--arguments</argument>
                    <argument>--gui</argument>
                    <argument>--jlink-options</argument>
                    <argument>--strip-debug --no-man-pages --no-header-files</argument>
                    <argument>--app-version</argument>
                    <argument>${project.version}</argument>
                    <argument>--description</argument>
                    <argument>Reports, downloads and baseline tools for Applitools Eyes</argument>
                    <argument>--copyright</argument>
                    <argument>Copyright © Applitools</argument>
                    <argument>--vendor</argument>
                    <argument>Applitools</argument>
                    <argument>--dest</argument>
                    <argument>${project.build.directory}/installers</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <properties>
        <dependency-check.skip>true</dependency-check.skip>
        <installer.input.jar>EyesUtilities_${project.version}.jar</installer.input.jar>
      </properties>
    </profile>
    <profile>
      <id>installer-os-windows</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.1.1</version>
            <executions>
              <execution>
                <id>run-jpackage</id>
                <configuration>
                  <arguments>
                    <argument>--win-menu</argument>
                    <argument>--win-shortcut</argument>
                    <argument>--win-dir-chooser</argument>
                    <argument>--win-upgrade-uuid</argument>
                    <argument>85d8963a-fa24-4481-bac5-25550c57c380</argument>
                    <argument>--icon</argument>
                    <argument>${project.basedir}/installer/icons/EyesUtilities.ico</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <properties>
        <installer.type>msi</installer.type>
      </properties>
    </profile>
    <profile>
      <id>installer-os-mac</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.1.1</version>
            <executions>
              <execution>
                <id>run-jpackage</id>
                <configuration>
                  <arguments>
                    <argument>--icon</argument>
                    <argument>${project.basedir}/installer/icons/EyesUtilities.icns</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <properties>
        <installer.type>dmg</installer.type>
      </properties>
    </profile>
    <profile>
      <id>installer-os-linux</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.1.1</version>
            <executions>
              <execution>
                <id>run-jpackage</id>
                <configuration>
                  <arguments>
                    <argument>--icon</argument>
                    <argument>${project.basedir}/installer/icons/EyesUtilities.png</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <properties>
        <installer.type>deb</installer.type>
      </properties>
    </profile>
  </profiles>
  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>hamcrest-core</artifactId>
          <groupId>org.hamcrest</groupId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.target>1.8</maven.compiler.target>
    <maven.compiler.source>1.8</maven.compiler.source>
  </properties>
</project>
