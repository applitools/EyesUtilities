<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.applitools.eyesutilities</groupId>
    <artifactId>EyesUtilities</artifactId>
    <version>1.7.0</version>
    <packaging>jar</packaging>

    <name>eyes-utilities</name>
    <url>http://maven.apache.org</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

		<!-- TODO : The Apache HttpComponents Project has deprecated HttpClient 4.x 
				"Users of HttpCore 4.x are strongly encouraged to migrate to HttpCore 5.x"
				https://hc.apache.org/status.html -->
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <version>4.5.13</version>
        </dependency>
        <!-- 
        	Migration guide https://hc.apache.org/httpcomponents-client-5.2.x/migration-guide/preparation.html 

		<dependency>
		    <groupId>org.apache.httpcomponents.client5</groupId>
		    <artifactId>httpclient5</artifactId>
		    <version>5.2</version>
		</dependency>
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.16.1</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.16.1</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.16.1</version>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.15.1</version>
        </dependency>

        <dependency>
            <groupId>com.beust</groupId>
            <artifactId>jcommander</artifactId>
            <version>1.82</version>
        </dependency>
        <dependency>
            <groupId>org.apache.velocity</groupId>
            <artifactId>velocity-engine-core</artifactId>
            <version>2.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.velocity.tools</groupId>
            <artifactId>velocity-tools-generic</artifactId>
            <version>3.1</version>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.10.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-stdlib-jdk7</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <build>
        <finalName>../jars/${project.artifactId}_${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>7.1.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- GUI (gui/): installs its own Node, builds the React bundle into gui/dist.
                 Iterate on Java alone with -Dskip.installnodenpm=true -Dskip.npm=true. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.0</version>
                <configuration>
                    <workingDirectory>gui</workingDirectory>
                    <installDirectory>${project.build.directory}</installDirectory>
                    <nodeVersion>v20.12.2</nodeVersion>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals><goal>install-node-and-npm</goal></goals>
                        <phase>generate-resources</phase>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <goals><goal>npm</goal></goals>
                        <phase>generate-resources</phase>
                        <configuration><arguments>ci</arguments></configuration>
                    </execution>
                    <execution>
                        <id>npm-run-build</id>
                        <goals><goal>npm</goal></goals>
                        <phase>generate-resources</phase>
                        <configuration><arguments>run build</arguments></configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Serves the built bundle from the jar at /web (see gui.GuiServer). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-gui-bundle</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <overwrite>true</overwrite>
                            <outputDirectory>${project.build.outputDirectory}/web</outputDirectory>
                            <resources>
                                <resource><directory>${project.basedir}/gui/dist</directory></resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Use lifecucle package to generate uber jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <transformers>
                        <transformer
                                implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <mainClass>com.applitools.eyesutilities.EyesUtilities</mainClass>
                        </transformer>
                    </transformers>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- This plugin required to control version addition to the manifest so it will be consumable on runtime -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <!--
            gui-installers: builds an installer for the host OS with jpackage that opens the GUI.
            Needs JDK 17+ (jpackage); the app still compiles for Java 8.
            Run with: mvn -Pgui-installers -DskipTests clean verify
            Output: target/installers/EyesUtilities-*.{msi|dmg|deb}
            The installer-os-* profiles below auto-activate on the host and set the type and icon.
        -->
        <profile>
            <id>gui-installers</id>
            <properties>
                <!-- The OWASP check is bound to verify; installer builds don't need it. -->
                <dependency-check.skip>true</dependency-check.skip>
                <installer.input.jar>EyesUtilities_${project.version}.jar</installer.input.jar>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>stage-installer-input</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/installer-input</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/jars</directory>
                                            <includes>
                                                <include>${installer.input.jar}</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.1</version>
                        <executions>
                            <execution>
                                <id>run-jpackage</id>
                                <phase>verify</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/installer-input</argument>
                                        <argument>--type</argument>
                                        <argument>${installer.type}</argument>
                                        <argument>--name</argument>
                                        <argument>EyesUtilities</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${installer.input.jar}</argument>
                                        <argument>--main-class</argument>
                                        <argument>com.applitools.eyesutilities.EyesUtilities</argument>
                                        <argument>--arguments</argument>
                                        <argument>--gui</argument>
                                        <!-- jpackage's default jlink options include strip-native-commands,
                                             but the GUI runs each utility in a child JVM from
                                             ${java.home}/bin/java (gui.UtilityProcess), so keep the launchers. -->
                                        <argument>--jlink-options</argument>
                                        <argument>--strip-debug --no-man-pages --no-header-files</argument>
                                        <argument>--app-version</argument>
                                        <argument>${project.version}</argument>
                                        <argument>--description</argument>
                                        <argument>Reports, downloads and baseline tools for Applitools Eyes</argument>
                                        <argument>--copyright</argument>
                                        <argument>Copyright © Applitools</argument>
                                        <argument>--vendor</argument>
                                        <argument>Applitools</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/installers</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            OS-detection sub-profiles for gui-installers: each auto-activates on its host and sets
            ${installer.type} plus OS-specific jpackage flags. Only consumed when -Pgui-installers
            is also active; harmless properties otherwise.
        -->
        <profile>
            <id>installer-os-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties>
                <!-- msi, not exe: jpackage's exe wrapper has no supportedOS manifest, so Windows
                     reports "This program might not have installed correctly" after a good install. -->
                <installer.type>msi</installer.type>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.1</version>
                        <executions>
                            <execution>
                                <id>run-jpackage</id>
                                <configuration>
                                    <arguments combine.children="append">
                                        <argument>--win-menu</argument>
                                        <argument>--win-shortcut</argument>
                                        <argument>--win-dir-chooser</argument>
                                        <!-- Fixed UpgradeCode so a new MSI replaces the previous install
                                             instead of adding a second entry. Must never change. -->
                                        <argument>--win-upgrade-uuid</argument>
                                        <argument>85d8963a-fa24-4481-bac5-25550c57c380</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/installer/icons/EyesUtilities.ico</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- jpackage builds for the JDK's own architecture: run on an Apple Silicon host
                 for an arm64 dmg and on an Intel host for an x64 one. -->
            <id>installer-os-mac</id>
            <activation><os><family>mac</family></os></activation>
            <properties>
                <installer.type>dmg</installer.type>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.1</version>
                        <executions>
                            <execution>
                                <id>run-jpackage</id>
                                <configuration>
                                    <arguments combine.children="append">
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/installer/icons/EyesUtilities.icns</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>installer-os-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <properties>
                <installer.type>deb</installer.type>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.1</version>
                        <executions>
                            <execution>
                                <id>run-jpackage</id>
                                <configuration>
                                    <arguments combine.children="append">
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/installer/icons/EyesUtilities.png</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
